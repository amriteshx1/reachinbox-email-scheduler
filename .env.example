# Copy to backend/.env (Prisma) and optionally repo-root .env
#   cp .env.example backend/.env

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001

DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox
REDIS_URL=redis://localhost:6380
ELASTICSEARCH_URL=http://localhost:9200

# Host ports 5433/6380 avoid colliding with a local Postgres/Redis on 5432/6379.
# Compose still uses 5432/6379 inside the containers.

# Generate a long random string for production
SESSION_SECRET=change-me-to-a-long-random-secret

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=http://localhost:3001/auth/slack/callback

# API process should leave this false; the dedicated worker process always runs workers
WORKER_ENABLED=false
WORKER_CONCURRENCY=5
WORKER_LOCK_DURATION_MS=30000
BULLMQ_PREFIX=bull

# Floor between individual sends per sender (campaign delay cannot go below this)
MIN_INTER_EMAIL_MS=2000

# Hard caps; campaign hourlyLimit is min(user value, per-sender cap)
MAX_EMAILS_PER_HOUR=1000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_LEADS_PER_CAMPAIGN=5000

# Optional shared Ethereal inbox. If unset, senders are created via Ethereal's API.
# ETHEREAL_USER=
# ETHEREAL_PASS=
# ETHEREAL_HOST=smtp.ethereal.email
# ETHEREAL_PORT=587
